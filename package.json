{
  "name": "@devv/grafana",
  "version": "0.5.0",
  "description": "Grafana dashboards as TSX components: write a dashboard as JSX, render the JSON Grafana reads, ship it as a ConfigMap, and let --check fail when a committed file drifts from its component.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx": "./src/jsx.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "biome check . && tsc --noEmit && bun test",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "peerDependencies": {
    "typescript": ">=5",
    "@types/bun": ">=1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tommylans/grafana-jsx"
  }
}
